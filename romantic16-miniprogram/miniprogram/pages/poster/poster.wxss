.poster-heading{padding:14rpx 20rpx 30rpx}.poster-title{font-size:44rpx;margin-top:12rpx}.poster-image{width:100%;border-radius:12rpx;box-shadow:0 16rpx 48rpx #59314220}.loading{min-height:600rpx;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:24rpx;text-align:center}.loading .serif{font-size:36rpx}.loading .muted{font-size:28rpx}.actions{margin-top:34rpx}.message{color:#823b58;font-size:28rpx;text-align:center;margin-top:24rpx;line-height:1.8}.qr-note{font-size:24rpx;text-align:center;margin-top:16rpx}.poster-canvas{position:fixed;left:-2000px;top:0;width:1080px;height:1800px;pointer-events:none}.privacy-mask{position:fixed;inset:0;z-index:50;background:#25162399;display:flex;justify-content:center;align-items:center;padding:32rpx}.privacy-card{width:100%;max-height:85vh;overflow:auto;border:2rpx solid white;border-radius:40rpx;background:#fcf4f1;padding:42rpx;font-size:30rpx;line-height:1.8}.privacy-title{font-size:42rpx;margin-bottom:24rpx}.contract{margin:20rpx 0;font-size:28rpx;text-align:left}
