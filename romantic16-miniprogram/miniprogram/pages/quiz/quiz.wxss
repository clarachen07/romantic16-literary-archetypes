.sequence{font-size:26rpx;margin-top:8rpx}.count{font:italic 34rpx Georgia,serif;color:#5b253e;white-space:nowrap}.progress{height:6rpx;border-radius:6rpx;background:#823b5815;overflow:hidden;margin:32rpx 0 42rpx}.progress>view{height:100%;background:linear-gradient(90deg,#b98f79,#99566e)}.kicker{font-size:26rpx;margin-bottom:16rpx}.question-title{font-size:42rpx;line-height:1.7;margin-bottom:38rpx;word-break:break-all}.options{display:flex;flex-direction:column;gap:20rpx}.choice{display:flex;align-items:center;gap:24rpx;min-height:112rpx;padding:26rpx;border-radius:34rpx;text-align:left;color:#352732;border:2rpx solid #fff;background:linear-gradient(125deg,#ffffffd9,#ffffff6b);box-shadow:inset 0 2rpx 0 #fff,inset 0 -2rpx 4rpx #70485510,0 8rpx 24rpx #683c5111;font-size:32rpx;line-height:1.65}.letter{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;flex-shrink:0;border:1rpx solid #823b5833;border-radius:50%;font:30rpx Georgia,serif;color:#823b58;background:#ffffff80}.choice-copy{flex:1}.selected{border-color:#933f5f80;background:linear-gradient(130deg,#f7e6ed,#efe0e9)}.selected .letter{background:#823b58;color:white;border-color:#823b58}.chosen-label{display:block;color:#823b58;font-size:24rpx;margin-top:12rpx}.equal{justify-content:center;text-align:center;font-size:30rpx;color:#75636c}.steps{display:flex;align-items:center;gap:16rpx;margin-bottom:26rpx}.steps text{font-size:26rpx;padding:10rpx 18rpx;color:#75636c;border-radius:18rpx}.steps .active{color:#5b253e;background:#90466317;font-weight:600}.steps view{width:40rpx;height:1rpx;background:#823b5833}.instruction{font-size:28rpx;line-height:1.8;margin-bottom:30rpx}.revise{text-align:right;margin-top:12rpx}.question-actions{display:flex;justify-content:space-between;align-items:center;gap:16rpx;border-top:1rpx solid #823b5820;margin-top:40rpx;padding-top:18rpx}.route-note{max-width:310rpx;font-size:24rpx;text-align:right}
