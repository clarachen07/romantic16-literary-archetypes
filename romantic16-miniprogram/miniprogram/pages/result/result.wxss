.result-panel{padding:42rpx 34rpx}.result-code{font:30rpx Georgia,serif;color:#96704c;letter-spacing:4rpx;margin-top:22rpx}.result-title{font-size:66rpx;line-height:1.4;margin:22rpx 0;color:#5b253e}.result-intro{font-size:30rpx;line-height:1.85;margin-bottom:42rpx}.profile{overflow:hidden;border:2rpx solid #ffffffc9;border-radius:36rpx;background:#ffffff6b;margin-bottom:34rpx}.portrait{position:relative}.portrait-image{width:100%}.portrait>text{position:absolute;left:22rpx;bottom:22rpx;padding:6rpx 12rpx;background:#291a22b8;border-radius:10rpx;color:#fff5ef;font-size:22rpx}.profile-copy{padding:36rpx}.profile-copy .result-code{margin-top:0}.profile-name{font-size:46rpx;margin:8rpx 0 14rpx}.figure{font-size:26rpx;line-height:1.8}.quote{margin:36rpx 0 28rpx;padding-left:24rpx;border-left:3rpx solid #bd8b99;color:#823b58;font-size:34rpx;line-height:1.8}.profile-copy>view:not(.quote):not(.profile-name):not(.result-code):not(.figure){font-size:30rpx;line-height:1.85}.story{margin-top:30rpx;border-top:1rpx solid #823b5820;padding-top:28rpx}.section{padding:38rpx 0;border-bottom:1rpx solid #823b5820;font-size:30rpx;line-height:1.9}.section-title{font-size:34rpx;margin-bottom:20rpx}.evidence+.evidence{margin-top:18rpx}.cost{padding:32rpx 26rpx;margin-top:30rpx;border:1rpx solid #974c6814;border-radius:30rpx;background:#b7778f13}.cost-item+.cost-item{margin-top:20rpx}.caution{color:#823b58;font-size:24rpx;margin-top:20rpx}.disclaimer{font-size:24rpx;line-height:1.9;text-align:center;margin:36rpx 0}.insufficient{padding:50rpx 10rpx;text-align:center}.insufficient .serif{font-size:40rpx;margin-bottom:24rpx}.insufficient .muted{font-size:30rpx}
