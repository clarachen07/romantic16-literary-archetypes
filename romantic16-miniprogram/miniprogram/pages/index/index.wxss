.intro-panel{padding:24rpx 0 0;overflow:hidden}.hero{position:relative;height:330rpx;margin:0 24rpx;overflow:hidden;border-radius:34rpx}.hero-image{width:100%;height:100%}.hero-shade{position:absolute;inset:0;background:linear-gradient(90deg,#25161db3,transparent 85%)}.hero-caption{position:absolute;left:32rpx;bottom:36rpx;color:#fff5ef;font-size:24rpx;display:flex;flex-direction:column;gap:12rpx}.french{font:italic 44rpx Georgia,serif}.intro-copy{padding:48rpx}.wordmark{font:normal 112rpx/.95 Georgia,'Times New Roman',serif;color:#5b253e;letter-spacing:-8rpx;margin:32rpx 0 42rpx;white-space:nowrap}.sup{display:inline-block;vertical-align:top;font-size:42rpx;font-style:italic;letter-spacing:0;color:#96704c;margin:0 0 0 8rpx}.lede{font-size:42rpx;line-height:1.8;margin-bottom:32rpx}.guidance{font-size:28rpx;line-height:1.9;margin-bottom:40rpx}.arrow{margin-left:36rpx}.time{text-align:center;font-size:26rpx;margin-top:20rpx}.notes{padding:40rpx 48rpx;border-top:1rpx solid #823b5820;background:#ffffff33}.notes>view{display:flex;gap:24rpx;margin-bottom:24rpx}.notes>view:last-child{margin-bottom:0}.notes text:first-child{flex-shrink:0;width:136rpx;font-size:28rpx}.notes text:last-child{color:#75636c;font-size:26rpx;line-height:1.8}
