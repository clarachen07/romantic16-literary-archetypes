page{background:#f5eae8;color:#352732;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;font-size:32rpx;line-height:1.65;min-height:100%;background-image:radial-gradient(ellipse at 5% 0%,#fff8ed,transparent 60%),linear-gradient(145deg,#f4e7e4,#eee5ed)}
view,text,button,image{box-sizing:border-box}button{font:inherit;line-height:1.5;margin:0}button::after{border:0}button[disabled]{opacity:.55}image{display:block}
.page{padding:24rpx 28rpx 48rpx;padding-bottom:calc(48rpx + env(safe-area-inset-bottom))}.panel{padding:40rpx;border:2rpx solid rgba(255,255,255,.92);border-radius:48rpx;background:linear-gradient(140deg,rgba(255,253,249,.86),rgba(255,247,247,.65));box-shadow:0 22rpx 60rpx rgba(80,43,64,.08),inset 0 2rpx 0 #fff}
.eyebrow{color:#823b58;font-size:26rpx;letter-spacing:2rpx}.serif{font-family:'Romantic Serif','Songti SC','STSong','Noto Serif CJK SC',serif;font-weight:500}.muted{color:#75636c}.privacy{font-size:24rpx;color:#75636c;text-align:center;margin-top:32rpx}.footer{color:#75636c;font-size:24rpx;text-align:center;margin-top:30rpx}
.primary,.secondary{display:flex;align-items:center;justify-content:center;min-height:104rpx;padding:24rpx 32rpx;border:2rpx solid rgba(255,255,255,.8);border-radius:34rpx;font-size:32rpx;font-weight:500}.primary{color:#fff8f8;background:linear-gradient(145deg,#a65f77,#76304e 80%);box-shadow:inset 0 2rpx 2rpx #ffffff80,0 10rpx 26rpx #6c2a4430}.secondary{color:#5b253e;background:rgba(255,255,255,.64);box-shadow:inset 0 2rpx 0 #fff,0 4rpx 16rpx #5931420c}.pressed{opacity:.8;transform:scale(.99)}
.text-button{min-height:88rpx;padding:16rpx 8rpx;color:#823b58;background:transparent;font-size:28rpx;text-align:center}.row{display:flex;align-items:center;justify-content:space-between;gap:24rpx}.button-stack{display:flex;flex-direction:column;gap:20rpx}.error{text-align:center;padding:52rpx 28rpx}.error-title{font-size:40rpx;margin-bottom:20rpx}.error .primary{margin-top:32rpx}
